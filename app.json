{
  "expo": {
    "name": "NIXHub Assistant",
    "slug": "nixhub-assistant",
    "version": "0.1.0",
    "scheme": "nixhub",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "id.nixhub.assistant"
    },
    "android": {
      "package": "id.nixhub.assistant",
      "adaptiveIcon": {
        "backgroundColor": "#18181b"
      },
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9ac3afad-6193-4f6c-8bb8-c873bfd741be"
      }
    }
  }
}
