{
  "expo": {
    "name": "NIXHub Assistant",
    "slug": "nixhub-assistant",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "nixhub",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "id.nixhub.assistant"
    },
    "android": {
      "package": "id.nixhub.assistant",
      "adaptiveIcon": {
        "backgroundColor": "#18181b"
      }
    },
    "plugins": ["expo-router", "expo-secure-store", "expo-sqlite"],
    "experiments": {
      "typedRoutes": false
    }
  }
}
